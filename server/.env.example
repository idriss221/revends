# ============================================================
# ReVends server — variables d'environnement (copier en .env)
# ============================================================

# PostgreSQL : DATABASE_URL (prioritaire) OU composants DB_* (compat)
DATABASE_URL=postgres://revends:revends_dev_password@localhost:5433/revends
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=revends
DB_PASSWORD=
# DB_NAME=revends

# Session (obligatoire en production : au moins 32 caractères)
SESSION_SECRET=change-me-with-a-long-random-secret

# Serveur
NODE_ENV=development
PORT=4000

# Uploads photos produits (chemin relatif au dossier server/)
UPLOAD_DIR=./uploads/products

# Métier
COMMISSION_RATE=0.10
RESERVATION_DAYS=5

# Cron d'expiration des réservations
DISABLE_CRON=false

# Seed admin (admin@revends.com par défaut ; mot de passe affiché si absent)
ADMIN_EMAIL=admin@revends.com
ADMIN_PASSWORD=

# Build front servé en prod (chemin relatif au dossier server/)
WEB_DIST=../web/dist

# ============================================================
# C1 / US-V5-01 — Emails transactionnels
# ============================================================
MAIL_ENABLED=false
# MAIL_HOST=smtp.exemple.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=apikey
MAIL_PASSWORD=
# MAIL_FROM="ReVends <no-reply@revends.com>"
SITE_URL=http://localhost:5173
# CORS : origines autorisées, séparées par des virgules.
# Vide ⇒ SITE_URL. `*` ignoré (incompatible credentials).
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Architecture distribuée (2026-10-11)
# ============================================================
INSTANCE_ID=
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=revends:
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=60
CACHE_ENABLED=true
SESSION_STORE=redis
RATE_LIMIT_BACKEND=redis

# (Sharding/réplication supprimés — variables DB_SHARD_* / CLUSTER_* retirées.)

RUN_MIGRATIONS=true

# ============================================================
# Postgres (pour docker-compose distributed)
# ============================================================
POSTGRES_PASSWORD=
POSTGRES_REPLICATION_PASSWORD=