# =====================================================================
# ReVends — Variables d'environnement (MODÈLE)
#
# Copier ce fichier vers `.env` puis remplacer TOUS les placeholders.
# `.env` est ignoré par git (.gitignore) : ne JAMAIS le committer.
#
# Générer les secrets :
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -hex 32      # POSTGRES_PASSWORD, REDIS_PASSWORD, PGADMIN_DEFAULT_PASSWORD
#
# Architecture : UN SEUL PostgreSQL = source de vérité unique.
# Le sharding et la réplication PostgreSQL ont été SUPPRIMÉS : les variables
# DB_SHARD_COUNT, SHARD0_*_URL, SHARD1_*_URL, CLUSTER_* et
# POSTGRES_REPLICATION_PASSWORD ne sont plus utilisées.
# =====================================================================

# ---------------------------------------------------
# APPLICATION
# ---------------------------------------------------
NODE_ENV=production
PORT=4000
# Identifiant de l'instance (logs/traces). Vide => hostname du conteneur.
INSTANCE_ID=

# ---------------------------------------------------
# POSTGRESQL — source de vérité unique
# ---------------------------------------------------
# Composants du conteneur (docker-compose).
POSTGRES_USER=revends
POSTGRES_DB=revends
# OBLIGATOIRE pour `docker compose` (échec explicite si absent). >= 12 caractères.
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES
# Port publié par le conteneur Postgres, lié à 127.0.0.1 (dev). Surchargeable.
POSTGRES_HOST_PORT=5433

# Pool de connexions applicatif (nombre max de clients Postgres).
PG_POOL_MAX=10

# Connexion applicative. En Docker, docker-compose force DATABASE_URL/DB_HOST=postgres ;
# ces valeurs servent au lancement hors Docker (dev local, migrations, scripts).
DATABASE_URL=postgresql://revends:REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES@localhost:5433/revends
DB_HOST=localhost
DB_PORT=5433
DB_USER=revends
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES
DB_NAME=revends

# ---------------------------------------------------
# SESSION & SÉCURITÉ
# ---------------------------------------------------
# OBLIGATOIRE : >= 32 caractères, sans motif faible (dev/change/test).
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_CARACTERES
# `true` derrière HTTPS (production). `false` uniquement en HTTP local.
COOKIE_SECURE=true

# ---------------------------------------------------
# ADMIN (seed)
# ---------------------------------------------------
ADMIN_EMAIL=admin@example.com
# OBLIGATOIRE : >= 12 caractères, sans motif faible.
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ADMIN

# ---------------------------------------------------
# MÉTIER
# ---------------------------------------------------
COMMISSION_RATE=0.10
RESERVATION_DAYS=5
# Désactive le cron d'expiration des réservations (utile pour >1 instance).
DISABLE_CRON=false

# ---------------------------------------------------
# REDIS — sessions + rate-limit + cache (protégé par mot de passe)
# ---------------------------------------------------
REDIS_URL=redis://localhost:6379
# OBLIGATOIRE pour `docker compose` (échec explicite si absent).
REDIS_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_REDIS
REDIS_PREFIX=revends:
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=60
CACHE_ENABLED=true
# Stockage des sessions : `redis` ou `pg`.
SESSION_STORE=redis
# Backend du rate-limit : `redis` ou `memory`.
RATE_LIMIT_BACKEND=redis
# Dérogation de recette (tests e2e) uniquement : ne pas activer en prod.
RATE_LIMIT_DISABLED=false
# Port publié par le conteneur Redis, lié à 127.0.0.1 (dev). Surchargeable.
REDIS_HOST_PORT=6379

# ---------------------------------------------------
# MIGRATIONS / UPLOADS / BUILD WEB
# ---------------------------------------------------
RUN_MIGRATIONS=true
MIGRATIONS_DIR=./migrations
# Chemin relatif au répertoire de lancement (dossier server/ en local).
UPLOAD_DIR=./uploads/products
# Chemin du build web servé en statique par l'API (relatif au dossier server/).
WEB_DIST=../web/dist

# ---------------------------------------------------
# SITE / CORS
# ---------------------------------------------------
SITE_URL=http://localhost:8080
# Origines autorisées (séparées par des virgules). Vide => [SITE_URL].
# `*` est ignoré (incompatible avec `credentials: true`).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Web (Vite) — développement uniquement. En prod même origine : laisser vide.
VITE_API_URL=

# ---------------------------------------------------
# MAIL (transactionnel) — désactivé par défaut
# ---------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=REMPLACER_PAR_UTILISATEUR_SMTP
MAIL_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_SMTP
MAIL_FROM="ReVends <no-reply@example.com>"

# ---------------------------------------------------
# OAUTH 2.0 — Google
# ---------------------------------------------------
GOOGLE_CLIENT_ID=REMPLACER_PAR_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=REMPLACER_PAR_CLIENT_SECRET_GOOGLE
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ---------------------------------------------------
# OAUTH 2.0 — Facebook
# ---------------------------------------------------
FACEBOOK_APP_ID=REMPLACER_PAR_APP_ID_FACEBOOK
FACEBOOK_APP_SECRET=REMPLACER_PAR_APP_SECRET_FACEBOOK
FACEBOOK_CALLBACK_URL=https://localhost/api/auth/facebook/callback

# ---------------------------------------------------
# OUTILS DE DÉVELOPPEMENT (docker-compose.override.yml, profils dev/tools)
# ---------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_PGADMIN

# ---------------------------------------------------
# TESTS (CI / npm test) — base de test isolée
# ---------------------------------------------------
TEST_DATABASE_URL=postgresql://revends:REMPLACER_PAR_UN_MOT_DE_PASSE@127.0.0.1:5433/revends_test
