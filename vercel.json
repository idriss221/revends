{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --include=dev --no-audit --no-fund && npm ci --prefix web --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build --prefix web",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "**": {
      "includeFiles": "public/**"
    }
  }
}
