{
  "name": "default-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:api:up": "docker compose -f ../docker-compose.yml --profile e2e up -d api-e2e",
    "e2e:api:down": "docker compose -f ../docker-compose.yml --profile e2e stop api-e2e",
    "test:e2e": "npm run build && npm run e2e:api:up && E2E_MODE=preview playwright test",
    "test:e2e:capture": "npm run build && npm run e2e:api:up && E2E_MODE=preview E2E_CAPTURE=1 playwright test e2e/captures.spec.ts",
    "test:e2e:dev": "npm run e2e:api:up && E2E_MODE=dev playwright test",
    "profile:build": "vite build",
    "profile:lhci": "lighthouse-ci",
    "profile:lhci:local": "lighthouse http://127.0.0.1:5181 --preset=chrome --output=json ./lh-report.json",
    "css:scope": "node scripts/bureau-css.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "lighthouse": "^11.7.0",
    "lighthouse-ci": "^1.13.1"
  }
}
