{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // `node` : les tests vitest (`src/**/*.test.ts`) tournent en environnement
    // Node et lisent les sources (`node:fs`/`node:path`) pour vérifier les
    // invariants cross-fichiers — l'invariant « zéro lien mort » notamment.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}